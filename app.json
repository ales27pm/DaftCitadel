{
  "expo": {
    "name": "Daft Citadel",
    "slug": "daft-citadel",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "dev.daftcitadel.app",
      "buildNumber": "6",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Daft Citadel uses the camera when you choose to share live video during a collaboration session.",
        "NSLocationWhenInUseUsageDescription": "Daft Citadel uses Wi-Fi signal quality to keep collaboration sessions reliable.",
        "NSMicrophoneUsageDescription": "Daft Citadel uses the microphone when you choose to record audio or communicate during a collaboration session."
      },
      "entitlements": {
        "com.apple.developer.networking.wifi-info": true
      }
    },
    "android": {
      "package": "dev.daftcitadel.app",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "name": "Daft Citadel"
    },
    "plugins": [
      "expo-sqlite",
      "./plugins/with-daft-citadel-native",
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.0"
          },
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ]
    ]
  }
}
