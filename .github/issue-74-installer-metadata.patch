@@ -0,0 +1,130 @@
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { spawnSync } = require('node:child_process');
+const test = require('node:test');
+
+const repositoryRoot = path.resolve(__dirname, '..', '..');
+const installerPath = path.join(repositoryRoot, 'scripts', 'daftcitadel.sh');
+const metadataGeneratorPath = path.join(
+  repositoryRoot,
+  'scripts',
+  'generate_metadata.py',
+);
+
+function extractShellFunction(source, functionName) {
+  const escapedName = functionName.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+  const match = source.match(
+    new RegExp(`^${escapedName}\\(\\)\\s*\\{\\r?\\n[\\s\\S]*?^\\}`, 'm'),
+  );
+
+  assert.ok(match, `Unable to locate ${functionName} in ${installerPath}`);
+  return match[0];
+}
+
+function encodeModules(payload) {
+  const installerSource = fs.readFileSync(installerPath, 'utf8');
+  const encoderDefinition = extractShellFunction(installerSource, 'encode_base64');
+  const result = spawnSync(
+    'bash',
+    ['-c', `${encoderDefinition}\nencode_base64`],
+    {
+      encoding: 'utf8',
+      input: payload,
+    },
+  );
+
+  assert.equal(result.status, 0, result.stderr);
+  return result.stdout;
+}
+
+function metadataArguments(temporaryRoot, encodedModules) {
+  const profileManifestPath = path.join(temporaryRoot, 'citadel_profile.json');
+  const pluginHintsPath = path.join(temporaryRoot, 'plugin_cache_hints.json');
+
+  return {
+    pluginHintsPath,
+    profileManifestPath,
+    args: [
+      metadataGeneratorPath,
+      `--profile-manifest-out=${profileManifestPath}`,
+      `--plugin-hints-out=${pluginHintsPath}`,
+      '--profile-manifest-version=2',
+      '--plugin-hints-version=1',
+      '--manifest-generated-at=2026-07-25T00:00:00Z',
+      '--plugin-hints-generated-at=2026-07-25T00:00:00Z',
+      '--profile=apex',
+      '--profile-name=Daft Citadel Apex',
+      `--base-path=${temporaryRoot}`,
+      `--log-path=${path.join(temporaryRoot, 'install.log')}`,
+      `--plugin-cache-path=${path.join(temporaryRoot, 'PluginCache')}`,
+      `--plugin-cache-hints-path=${pluginHintsPath}`,
+      '--feature-ai=false',
+      '--feature-gui=false',
+      '--feature-expanded-synths=true',
+      '--feature-heavy-assets=false',
+      '--feature-groove-tools=false',
+      '--feature-experimental-synths=false',
+      '--feature-container=false',
+      '--plugin-hint-format=vst3',
+      '--plugin-hint-identifier=helm',
+      '--plugin-hint-name=Helm',
+      '--plugin-hint-binary-path=/usr/lib/vst3/Helm.vst3',
+      `--plugin-hint-cache-path=${path.join(temporaryRoot, 'PluginCache', 'vst3', 'helm')}`,
+      '--plugin-hint-enabled=true',
+      '--plugin-hint-available=true',
+      '--plugin-hint-version=1.0.0',
+      `--plugin-hint-modules=${encodedModules}`,
+    ],
+  };
+}
+
+test('installer metadata preserves encoded plugin modules end to end', () => {
+  const temporaryRoot = fs.mkdtempSync(
+    path.join(os.tmpdir(), 'daftcitadel-installer-metadata-'),
+  );
+  const modulePayload = 'core\nsynths\n';
+
+  try {
+    const encodedModules = encodeModules(modulePayload);
+    assert.equal(encodedModules, Buffer.from(modulePayload).toString('base64'));
+    assert.equal(
+      Buffer.from(encodedModules, 'base64').toString('utf8'),
+      modulePayload,
+    );
+
+    const { args, pluginHintsPath } = metadataArguments(
+      temporaryRoot,
+      encodedModules,
+    );
+    const result = spawnSync('python3', args, { encoding: 'utf8' });
+
+    assert.equal(result.status, 0, result.stderr);
+    const pluginHints = JSON.parse(fs.readFileSync(pluginHintsPath, 'utf8'));
+    assert.deepEqual(pluginHints.hints[0].modules, ['core', 'synths']);
+  } finally {
+    fs.rmSync(temporaryRoot, { force: true, recursive: true });
+  }
+});
+
+test('installer metadata rejects malformed base64 without writing output', () => {
+  const temporaryRoot = fs.mkdtempSync(
+    path.join(os.tmpdir(), 'daftcitadel-installer-metadata-invalid-'),
+  );
+
+  try {
+    const { args, pluginHintsPath, profileManifestPath } = metadataArguments(
+      temporaryRoot,
+      '%%%',
+    );
+    const result = spawnSync('python3', args, { encoding: 'utf8' });
+
+    assert.notEqual(result.status, 0);
+    assert.match(result.stderr, /Invalid base64 payload for plugin modules/);
+    assert.equal(fs.existsSync(profileManifestPath), false);
+    assert.equal(fs.existsSync(pluginHintsPath), false);
+  } finally {
+    fs.rmSync(temporaryRoot, { force: true, recursive: true });
+  }
+});
