{
  "name": "daft-citadel-audio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx && eslint scripts/nativeDevGateway.js scripts/nativeDevSupervisor.js scripts/__tests__/nativeDevSupervisor.test.js",
    "test": "npx --yes jest && npm run test:native-dev",
    "typecheck": "tsc --noEmit",
    "prettier": "prettier --write \"{src,docs}/**/*.{ts,tsx,md}\" scripts/nativeDevGateway.js scripts/nativeDevSupervisor.js scripts/__tests__/nativeDevSupervisor.test.js",
    "native-dev": "node scripts/nativeDevSupervisor.js",
    "test:native-dev": "node --test scripts/__tests__/nativeDevSupervisor.test.js",
    "manage:agents": "node scripts/manageAgents.js",
    "maintain:docs": "node scripts/maintainDocs.js",
    "postinstall": "node scripts/patchExpoVirtualStreams.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.25",
    "@shopify/react-native-skia": "2.2.12",
    "buffer": "^6.0.3",
    "expo": "54.0.36",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-sqlite": "16.0.10",
    "expo-status-bar": "3.0.9",
    "expo-symbols": "~1.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "2.28.0",
    "react-native-reanimated": "4.1.1",
    "react-native-safe-area-context": "5.6.0",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "0.21.0",
    "react-native-webrtc": "124.0.8",
    "react-native-worklets": "0.5.1",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@react-native/eslint-config": "0.81.5",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.16.3",
    "@types/react": "19.1.17",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "react-test-renderer": "19.1.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "maxWorkers": 2,
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/lib/"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.jest.json"
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|react-native-.*|@react-navigation)/)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}"
    ],
    "moduleNameMapper": {
      "^react-native$": "<rootDir>/__mocks__/react-native.ts",
      "^react-native-reanimated$": "<rootDir>/__mocks__/react-native-reanimated.ts",
      "^react-native-svg$": "<rootDir>/__mocks__/react-native-svg.tsx",
      "^@shopify/react-native-skia$": "<rootDir>/__mocks__/@shopify/react-native-skia.ts",
      "^react-native-webrtc$": "<rootDir>/__mocks__/react-native-webrtc.ts",
      "^@react-native-async-storage/async-storage$": "<rootDir>/__mocks__/@react-native-async-storage/async-storage.ts",
      "^@react-native-community/slider$": "<rootDir>/__mocks__/react-native-community-slider.tsx",
      "^@expo/vector-icons/MaterialCommunityIcons$": "<rootDir>/__mocks__/material-community-icons.tsx",
      "^expo-image$": "<rootDir>/__mocks__/expo-image.tsx",
      "^expo-symbols$": "<rootDir>/__mocks__/expo-symbols.tsx",
      "^expo-status-bar$": "<rootDir>/__mocks__/expo-status-bar.ts",
      "^expo-sqlite/localStorage/install$": "<rootDir>/__mocks__/expo-sqlite-local-storage.ts",
      "^react-native-safe-area-context$": "<rootDir>/__mocks__/react-native-safe-area-context.ts",
      "\\.(png|jpe?g|webp)$": "<rootDir>/__mocks__/asset.ts"
    }
  }
}
