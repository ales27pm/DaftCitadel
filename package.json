{
  "name": "daft-citadel-audio",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "expo:doctor": "expo-doctor",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest",
    "test:ci": "TZ=UTC jest --runInBand --silent",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"{src,docs}/**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"{src,docs}/**/*.{ts,tsx,md}\"",
    "manage:agents": "node scripts/manageAgents.js",
    "maintain:docs": "node scripts/maintainDocs.js",
    "docs:check": "node scripts/maintainDocs.js --check --no-prettier",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify": "node scripts/verifyLocal.js",
    "verify:sanitize": "node scripts/verifyLocal.js --sanitize",
    "native:core:test:direct": "node scripts/verifyNativeCore.js",
    "native:core:test:direct:sanitize": "node scripts/verifyNativeCore.js --sanitize",
    "native:core:test": "cmake -S audio-engine -B audio-engine/build -DDAFT_AUDIO_ENGINE_BUILD_TESTS=ON && cmake --build audio-engine/build --parallel && ctest --test-dir audio-engine/build --output-on-failure",
    "native:core:test:sanitize": "cmake -S audio-engine -B audio-engine/build-sanitize -DDAFT_AUDIO_ENGINE_BUILD_TESTS=ON -DDAFT_AUDIO_ENGINE_ENABLE_SANITIZERS=ON -DCMAKE_BUILD_TYPE=Debug && cmake --build audio-engine/build-sanitize --parallel && ctest --test-dir audio-engine/build-sanitize --output-on-failure"
  },
  "dependencies": {
    "@expo/metro-runtime": "6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.25",
    "@shopify/react-native-skia": "2.2.12",
    "buffer": "^6.0.3",
    "daft-citadel-native": "file:modules/daft-citadel-native",
    "expo": "54.0.36",
    "expo-build-properties": "1.0.10",
    "expo-dev-client": "6.0.21",
    "expo-status-bar": "3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "2.28.0",
    "react-native-reanimated": "4.1.1",
    "react-native-safe-area-context": "5.6.0",
    "react-native-screens": "4.16.0",
    "react-native-web": "0.21.0",
    "react-native-webrtc": "^124.0.7",
    "react-native-worklets": "0.5.1",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@react-native/eslint-config": "0.81.5",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.16.3",
    "@types/react": "19.1.17",
    "@types/react-test-renderer": "19.1.0",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "babel-preset-expo": "54.0.12",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "expo-doctor": "1.20.1",
    "jest": "^29.7.0",
    "pod-install": "1.1.0",
    "prettier": "^3.2.5",
    "react-test-renderer": "19.1.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/lib/"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.jest.json"
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native|react-native-.*|@react-navigation)/)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}"
    ],
    "moduleNameMapper": {
      "^react-native$": "<rootDir>/__mocks__/react-native.ts",
      "^react-native-reanimated$": "<rootDir>/__mocks__/react-native-reanimated.ts",
      "^@shopify/react-native-skia$": "<rootDir>/__mocks__/@shopify/react-native-skia.ts",
      "^react-native-webrtc$": "<rootDir>/__mocks__/react-native-webrtc.ts",
      "^@react-native-async-storage/async-storage$": "<rootDir>/__mocks__/@react-native-async-storage/async-storage.ts"
    }
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      },
      "reactNativeDirectoryCheck": {
        "exclude": [
          "daft-citadel-native",
          "react-native-webrtc"
        ]
      }
    }
  },
  "overrides": {
    "postcss": "8.5.10",
    "uuid": "11.1.1"
  }
}
