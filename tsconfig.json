{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowJs": false,
    "strict": true,
    "baseUrl": ".",
    "rootDir": ".",
    "outDir": "lib",
    "jsx": "react-native",
    "types": ["jest", "node", "react-test-renderer"],
    "typeRoots": [
      "./src/types",
      "./node_modules/@types",
      "./node_modules/react-native/types"
    ],
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["App.tsx", "src/**/*"],
  "exclude": ["node_modules", "lib"],
  "extends": "expo/tsconfig.base"
}
